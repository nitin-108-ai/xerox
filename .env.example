# Smart Xerox Environment Variables Configuration Template
# Copy this file to .env before starting the application

# Server Configuration
NODE_ENV=production
PORT=5000
FRONTEND_URL=http://localhost:3000

# Security & Secrets (Use strong 256-bit keys in production)
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# Database Configuration
# Standard PostgreSQL: postgres://username:password@localhost:5432/smartxerox
# If DATABASE_URL is unset, the system automatically uses embedded PGlite for zero-config local run
DATABASE_URL=postgres://smartxerox_user:secure_password_here@localhost:5432/smartxerox_db
PGLITE_DATA_DIR=

# File Storage Configuration
STORAGE_PATH=./private_storage
MAX_FILE_SIZE_MB=50

# Document Retention Policy (in hours)
DEFAULT_RETENTION_HOURS=24
RETENTION_INTERVAL_MS=60000
